<?xml version="1.0" encoding="utf-8"?>
<!--
  Dasselbe fuer Android 12 und neuer: einmal fuer das Backup in der Cloud,
  einmal fuer die direkte Uebernahme auf ein neues Geraet.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_flutter"/>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_flutter"/>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
    </device-transfer>
</data-extraction-rules>
